rules:
  - id: lopdgdd-pii-without-consent
    pattern: user.email
    message: "Verificar consentimiento LOPDGDD"
    
  - id: lopdgdd-data-retention
    pattern: DELETE FROM users
    message: "Verificar período retención"

# .github/workflows/semgrep.yml (nuevo)
