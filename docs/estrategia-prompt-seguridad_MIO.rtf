11) Plantillas \'fatiles (ilustrativas)\par
Circuit breaker con retry/backoff (TypeScript):\par
import pRetry from 'p-retry';\par
import CircuitBreaker from 'opossum';\par
\par
const callLLM = async (input: Prompt) => \{ /* ... */ \};\par
\par
const breaker = new CircuitBreaker(callLLM, \{ timeout: 8000, errorThresholdPercentage: 50, resetTimeout: 10000 \});\par
\par
export const safeLLMCall = (input: Prompt) =>\par
  pRetry(() => breaker.fire(input), \{ retries: 2, factor: 2, minTimeout: 300 \});\par
