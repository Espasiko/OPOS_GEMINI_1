{
	"servers": {
		"huggingface": {
			"type": "http",
			"url": "https://hf.co/mcp",
			"gallery": true
		},
		"markitdown": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"markitdown-mcp"
			],
			"gallery": true
		},
		"imagesorcery": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"imagesorcery-mcp==latest"
			],
			"gallery": true
		},
		"deepwiki": {
			"type": "http",
			"url": "https://mcp.deepwiki.com/sse",
			"gallery": true
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"gallery": true
		},
		"playwright": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@playwright/mcp@latest"
			],
			"gallery": true
		},
		"convex": {
			"command": "npx",
			"args": [
				"-y",
				"convex@latest",
				"mcp",
				"start"
			],
			"type": "stdio"
		},
		"Vercel": {
			"url": "https://mcp.vercel.com",
			"type": "http"
		},
		"oraios/serena": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"--from",
				"git+https://github.com/oraios/serena",
				"serena",
				"start-mcp-server",
				"serena==latest",
				"--context",
				"ide-assistant"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		},
		"io.github.ChromeDevTools/chrome-devtools-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"chrome-devtools-mcp@0.10.2"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "0.10.2"
		}
	},
	"inputs": []
}