# ============================================================================
# OpositAIA Backend Configuration - EXAMPLE
# ============================================================================
# Copy this file to .env.backend and update with your actual API keys
#
# Quick Start:
# 1. Copy: cp .env.example .env.backend
# 2. Add your API keys below
# 3. Restart backend: uvicorn main:app --reload
# ============================================================================

# ----------------------------------------------------------------------------
# LLM PROVIDERS - Add your API keys here
# ----------------------------------------------------------------------------

# Groq (Ultra fast, free up to 500K tokens/day)
# Get your key at: https://console.groq.com/keys
# Models: llama-3.1-8b-instant, llama-3.3-70b-versatile, mixtral-8x7b-32768
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek (Cheap $0.21/M tokens, very powerful)
# Get your key at: https://platform.deepseek.com/api_keys
# Model: deepseek-chat (V3)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini (Multimodal, free up to 1.5M tokens/day)
# Get your key at: https://aistudio.google.com/app/apikey
# Models: gemini-2.0-flash-exp, gemini-2.5-pro, gemini-3-pro-preview
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face (Multiple models, ~$0.50-0.70/M tokens)
# Get your token at: https://huggingface.co/settings/tokens
# Models: Llama-3.1-70B, Mixtral-8x7B, Qwen2.5-72B
HF_TOKEN=your_huggingface_token_here

# Cohere (Production optimized, ~$0.50-3/M tokens)
# Get your key at: https://dashboard.cohere.com/api-keys
# Models: command-r, command-r-plus
COHERE_API_KEY=your_cohere_api_key_here

# Mistral VPS (Fallback always available - llama.cpp server)
# Using direct port 8080 because Nginx /v1/ has issues
MISTRAL_URL=http://147.93.95.67:8080
MISTRAL_MODEL=mistral

# ----------------------------------------------------------------------------
# RAG CONFIGURATION
# ----------------------------------------------------------------------------

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=
# Embedding Model (RoBERTalex for Spanish legal text)
EMBEDDING_MODEL=PlanTL-GOB-ES/RoBERTalex

# ----------------------------------------------------------------------------
# OPTIONAL SERVICES
# ----------------------------------------------------------------------------

# Ollama (Local LLM - optional)
OLLAMA_URL=http://localhost:11434

# ----------------------------------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------------------------------

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://opositaia.com

# Logging
LOG_LEVEL=INFO

# Development mode
DEBUG=true
