# OpositaIA Backend Configuration
# Copy this file to .env.backend and fill in your values

# ============================================
# QDRANT CLOUD (Vector Database) - REQUIRED
# ============================================
# Get your free cluster at: https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster-id.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=opositaia_leyes_seguridad_social

# ============================================
# SUPABASE POSTGRESQL - REQUIRED
# ============================================
# Get your free database at: https://supabase.com/
# Format: postgresql://postgres:password@host:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# ============================================
# EMBEDDING MODEL
# ============================================
# Spanish legal text embedding model (downloads automatically)
EMBEDDING_MODEL=PlanTL-GOB-ES/RoBERTalex

# ============================================
# OLLAMA (Optional - for local models)
# ============================================
OLLAMA_URL=http://localhost:11434

# ============================================
# AI MODEL API KEYS (Optional but recommended)
# ============================================
# Google Gemini (FREE): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (FREE): https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (Pay-per-use): https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Mistral (Pay-per-use): https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# ============================================
# MISTRAL VPS (Optional - if you have a VPS)
# ============================================
MISTRAL_VPS_URL=http://your-vps-ip:11434
MISTRAL_VPS_ENABLED=false

# ============================================
# BOE API (Spanish Official Gazette)
# ============================================
BOE_BASE_URL=https://www.boe.es
BOE_API_URL=https://www.boe.es/diario_boe/xml.php

# ============================================
# FASTAPI CONFIGURATION
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
