# ============================================================================
# OpositAIA Backend Configuration - EXAMPLE
# ============================================================================
# Copia este archivo a .env.backend y llena con tus propias credenciales

# ----------------------------------------------------------------------------
# LLM PROVIDERS
# ----------------------------------------------------------------------------

# Groq (Ultra rápido, gratis hasta 500K tokens/día)
GROQ_API_KEY=your_groq_key_here

# DeepSeek (Barato $0.21/M tokens)
DEEPSEEK_API_KEY=your_deepseek_key_here

# Google Gemini (Multimodal, gratis hasta 1.5M tokens/día)
GEMINI_API_KEY=your_gemini_key_here

# Hugging Face
HF_TOKEN=your_hf_token_here

# Cohere
COHERE_API_KEY=your_cohere_key_here

# Mistral VPS (Fallback)
MISTRAL_URL=http://147.93.95.67:8080
MISTRAL_MODEL=mistral

# ----------------------------------------------------------------------------
# RAG CONFIGURATION
# ----------------------------------------------------------------------------

# Qdrant Cloud
QDRANT_URL=https://your-qdrant-cloud-url.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_key_here

COLLECTION_NAME=opositaia_leyes_seguridad_social

# Embedding Model (RoBERTalex para español legal)
EMBEDDING_MODEL=PlanTL-GOB-ES/RoBERTalex

# ----------------------------------------------------------------------------
# OPTIONAL SERVICES
# ----------------------------------------------------------------------------

# Ollama (Local LLM - opcional)
OLLAMA_URL=http://localhost:11434

# ----------------------------------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------------------------------

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://opositaia.com

# Logging
LOG_LEVEL=INFO
DEBUG=true

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# ----------------------------------------------------------------------------

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=opositaia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opositaia
