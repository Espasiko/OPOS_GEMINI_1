# Production Environment Variables
# Copy this to .env in your VPS backend directory

# --- Server Config ---
HOST=0.0.0.0
PORT=8000
# Allow only your frontend domain in production
CORS_ORIGINS=["https://your-app.vercel.app"]

# Qdrant (Vector DB) - Use Qdrant Cloud for production
QDRANT_URL=https://your-cluster-url.qdrant.tech
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=opositaia_leyes_seguridad_social
EMBEDDING_MODEL=PlanTL-GOB-ES/RoBERTalex

# Database (PostgreSQL) - Use Vercel Postgres (Neon)
DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/dbname?sslmode=require

# --- Database ---
# Use internal Docker network DNS if running in same compose
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opositaia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password

# --- Vector DB ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=your_qdrant_key

# --- LLM Providers ---
# Get keys from respective provider dashboards

# Groq (Fast & Cheap)
GROQ_API_KEY=gsk_...

# DeepSeek (Cost Effective)
DEEPSEEK_API_KEY=sk-...

# Google Gemini (Multimodal)
GEMINI_API_KEY=AIza...

# Cohere (Production Grade)
COHERE_API_KEY=...

# Mistral VPS (Self-hosted)
# If running locally on same VPS
MISTRAL_URL=http://mistral:8080
