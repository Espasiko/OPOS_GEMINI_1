# OpositaIA Backend Configuration
# Copy this file to .env.backend and fill in your values

# ============================================
# Gemini API (Required)
# ============================================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Qdrant Configuration
# ============================================
QDRANT_API_KEY=your-api_key
 # Optional, leave empty for local
QDRANT_COLLECTION_NAME=opositaia_leyes_seguridad_social
QDRANT_URL=cloud o local

# ============================================
# Ollama Configuration (Local)
# ============================================
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_LLM_MODEL=tinyllama

# ============================================
# Mistral Configuration (Optional - VPS)
# ============================================
# If you have access to Mistral on VPS
MISTRAL_URL=http://147.93.95.67:8000
MISTRAL_MODEL=mistral-8b-gguf
MISTRAL_API_KEY=  # If protected
MISTRAL_ENABLED=false  # Set to true when available

# ============================================
# BOE API Configuration
# ============================================
BOE_BASE_URL=https://www.boe.es
BOE_API_URL=https://www.boe.es/diario_boe/xml.php

# ============================================
# FastAPI Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1

# ============================================
# Vector Database Settings
# ============================================
VECTOR_DIMENSION=1024  # bge-m3 dimension (was 384 for all-minilm)
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# ============================================
# ETL Configuration
# ============================================
ETL_SCHEDULE_CRON=0 2 * * *  # 2 AM daily
ETL_DAYS_BACK=30  # Days to sync

# ============================================
# Model Selection Strategy
# ============================================
# Options: gemini | ollama | mistral
DEFAULT_MODEL=gemini
EMBEDDING_MODEL=ollama  # Always use Ollama for embeddings (free)

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
