def validate_arithmetic_precision(caso_json: dict) -> tuple:
    """
    Validador aritmético exacto (propuesta DeepSeek)
    Detecta errores como 1.080€ vs 1.087€
    """
    try:
        opciones = caso_json.get("opciones", {})
        errores = []
        
        for letra, texto in opciones.items():
            # Extraer cuantía declarada
            match_cuantia = re.search(r'(\d+(?:\.\d+)?)€', texto)
            if not match_cuantia:
                continue
            
            cuantia_declarada = float(match_cuantia.group(1))
            
            # Extraer fórmula
            match_formula = re.search(r'\(([^)]+)\)', texto)
            if not match_formula:
                continue
            
            formula = match_formula.group(1)
            
            try:
                # Limpiar para evaluar
                formula_limpia = (formula
                    .replace('€', '').replace('días', '').replace('día', '')
                    .replace('%', '/100').replace('×', '*').replace('÷', '/')
                    .replace(',', '.'))
                
                # Evaluar con seguridad
                cuantia_calculada = eval(formula_limpia, {"__builtins__": {}})
                
                # Validar con margen ±1€
                if abs(cuantia_declarada - cuantia_calculada) > 1.0:
                    errores.append(
                        f"Opción {letra}: Declara {cuantia_declarada}€, "
                        f"pero fórmula da {cuantia_calculada:.2f}€ "
                        f"(diferencia: {abs(cuantia_declarada - cuantia_calculada):.2f}€)"
                    )
            except:
                continue
        
        if errores:
            return False, " | ".join(errores)
        
        return True, "Precisión aritmética correcta"
    
    except Exception as e:
        return True, f"No se pudo validar aritmética: {str(e)}"


def validate_mes_referencia(caso_json: dict) -> tuple:
    """
    Valida que el enunciado especifique el mes de la base
    (Recomendación DeepSeek + Claude)
    """
    enunciado = caso_json.get("enunciado", "")
    
    # Debe contener "base de cotización del mes de [MES] [AÑO]: X€"
    # o "base de cotización de [MES] [AÑO]: X€"
    pattern = r'base.*?(enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|octubre|noviembre|diciembre)\s+de?\s+202\d'
    
    if not re.search(pattern, enunciado, re.I):
        return False, "Enunciado debe especificar mes de referencia de la base (ej: 'base de marzo 2024: X€')"
    
    return True, "Mes de referencia especificado correctamente"


def validate_economic_realism(caso_json: dict) -> tuple:
    """Validador de realismo económico (ya existente)"""
    try:
        enunciado = caso_json.get("enunciado", "")
        
        base_match = re.search(r'base.*?(\d+\.?\d*)€', enunciado, re.I)
        if not base_match:
            return True, "No se pudo extraer base"
        
        base_mensual = float(base_match.group(1))
        
        # Validar contra bases problemáticas conocidas
        bases_evitar = BASES_LEGALES_2024["RGSS"]["bases_evitar"]
        if base_mensual in bases_evitar:
            return False, f"Base {base_mensual}€ es conocida por causar problemas. Usa bases comunes: {BASES_LEGALES_2024['RGSS']['bases_comunes']}"
        
        # Validar rango legal
        if base_mensual < BASES_LEGALES_2024["RGSS"]["min_mensual"]:
            return False, f"Base {base_mensual}€ inferior a mínimo legal {BASES_LEGALES_2024['RGSS']['min_mensual']}€"
        
        if base_mensual > BASES_LEGALES_2024["RGSS"]["max_mensual"]:
            return False, f"Base {base_mensual}€ superior a tope legal {BASES_LEGALES_2024['RGSS']['max_mensual']}€"
        
        return True, "Datos económicamente realistas"
    
    except Exception as e:
        return True, f"Error en validación: {str(e)}"


def validate_caso_it_COMPLETE(caso_json: dict) -> tuple:
    """
    Validador COMPLETO que integra todas las validaciones
    """
    # 1. Formato JSON
    required_fields = ["id", "enunciado", "opciones", "respuesta_correcta", "razonamiento", "normativa"]
    for field in required_fields:
        if field not in caso_json or not caso_json[field]:
            return False, f"[FORMATO] Falta campo: {field}"
    
    # 2. Realismo económico
    is_realistic, msg = validate_economic_realism(caso_json)
    if not is_realistic:
        return False, f"[REALISMO] {msg}"
    
    # 3. Mes de referencia
    has_mes, msg = validate_mes_referencia(caso_json)
    if not has_mes:
        return False, f"[MES_REF] {msg}"
    
    # 4. Precisión aritmética
    is_precise, msg = validate_arithmetic_precision(caso_json)
    if not is_precise:
        return False, f"[ARITMÉTICA] {msg}"
    
    # 5. Normativa mínima
    if len(caso_json.get("normativa", [])) < 2:
        return False, "[NORMATIVA] Se requieren al menos 2 artículos"
    
    return True, "Caso válido en todos los aspectos"


